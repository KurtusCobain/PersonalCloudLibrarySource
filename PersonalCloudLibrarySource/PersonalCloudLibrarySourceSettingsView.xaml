<UserControl x:Class="PersonalCloudLibrarySource.PersonalCloudLibrarySourceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="820">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Personal Cloud Library Source"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock Text="Configure the library source, manifest, cache, notifications, and troubleshooting tools. Everyday actions are also available from the Cloud Library dashboard."
                       TextWrapping="Wrap"
                       Margin="0,5,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="Setup status" Margin="0,0,0,14">
                            <StackPanel Margin="12">
                                <TextBlock Text="{Binding SetupStatusHeadline}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SetupStatusDetails}"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <CheckBox Content="Enable this library source"
                                  IsChecked="{Binding Settings.Enabled}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Library display name" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.LibraryDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,5,0,14" />

                        <GroupBox Header="Playnite access" Margin="0,0,0,14">
                            <StackPanel Margin="12">
                                <CheckBox Content="Show the top-panel Cloud Library button"
                                          IsChecked="{Binding Settings.ShowTopPanelButton}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Show the Cloud Library sidebar dashboard"
                                          IsChecked="{Binding Settings.ShowSidebarDashboard}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Open the Cloud Library dashboard when Playnite starts"
                                          IsChecked="{Binding Settings.OpenDashboardAtStartup}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Show setup reminders when configuration needs attention"
                                          IsChecked="{Binding Settings.ShowSetupReminders}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Startup behavior">
                            <StackPanel Margin="12">
                                <CheckBox Content="Refresh dashboard and library status when Playnite starts"
                                          IsChecked="{Binding Settings.AutoRefreshOnApplicationStart}"
                                          Margin="0,0,0,8" />
                                <CheckBox Content="Generate the manifest from the configured folder when Playnite starts"
                                          IsChecked="{Binding Settings.AutoGenerateManifestOnApplicationStart}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Source">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Source type" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding ProviderTypeOptions}"
                                  SelectedItem="{Binding Settings.SourceProviderType, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left"
                                  MinWidth="260"
                                  Margin="0,5,0,5" />
                        <TextBlock Text="Existing manifest uses one JSON catalog. Local folder supports internal drives, external drives, mapped drives, synced folders, and NAS paths. Rclone remote supports user-configured cloud providers."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16" />

                        <GroupBox Header="Existing manifest or local/NAS library" Margin="0,0,0,14">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Manifest JSON path" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding Settings.LocalManifestPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,8,12" />
                                <Button Grid.Row="1" Grid.Column="1"
                                        Content="Browse"
                                        Width="90"
                                        Margin="0,5,0,12"
                                        Click="BrowseLocalManifestPath_Click" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Library root folder or network path" FontWeight="SemiBold" />
                                <TextBox Grid.Row="3" Grid.Column="0"
                                         Text="{Binding Settings.LocalLibraryRoot, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,8,12" />
                                <Button Grid.Row="3" Grid.Column="1"
                                        Content="Browse"
                                        Width="90"
                                        Margin="0,5,0,12"
                                        Click="BrowseLocalLibraryRoot_Click" />

                                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Manifest path relative to the library root (optional)" FontWeight="SemiBold" />
                                <TextBox Grid.Row="5" Grid.ColumnSpan="2"
                                         Text="{Binding Settings.ManifestRelativePath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,0,0" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Cloud storage through rclone">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="rclone executable" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding Settings.RcloneExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,8,12" />
                                <Button Grid.Row="1" Grid.Column="1"
                                        Content="Browse"
                                        Width="90"
                                        Margin="0,5,0,12"
                                        Click="BrowseRcloneExecutablePath_Click" />

                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Configured remote name" FontWeight="SemiBold" />
                                <TextBox Grid.Row="3" Grid.ColumnSpan="2"
                                         Text="{Binding Settings.RcloneRemoteName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,0,12" />

                                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Remote manifest path" FontWeight="SemiBold" />
                                <TextBox Grid.Row="5" Grid.ColumnSpan="2"
                                         Text="{Binding Settings.RcloneManifestPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,0,12" />

                                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="Remote content root" FontWeight="SemiBold" />
                                <TextBox Grid.Row="7" Grid.ColumnSpan="2"
                                         Text="{Binding Settings.RcloneContentRoot, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,5,0,12" />

                                <WrapPanel Grid.Row="8" Grid.ColumnSpan="2">
                                    <Button Content="Test rclone connection"
                                            Click="TestRcloneConnection_Click"
                                            Margin="0,0,8,8"
                                            Padding="10,5" />
                                    <Button Content="Test manifest load"
                                            Click="TestManifestLoad_Click"
                                            Margin="0,0,8,8"
                                            Padding="10,5" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Manifest">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Generate a version 3 manifest from a local folder, external drive, mapped drive, synced folder, or NAS root without leaving Playnite. Existing externally managed manifests are never rewritten automatically."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Generate manifest from folder"
                                    Click="GenerateManifestFromFolder_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Open generated manifest"
                                    Click="OpenGeneratedManifest_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Open generation report"
                                    Click="OpenGeneratedReport_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Create sample manifest"
                                    Click="CreateSampleManifest_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                        </WrapPanel>

                        <GroupBox Header="Last generated manifest">
                            <Grid Margin="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Path" FontWeight="SemiBold" />
                                <TextBox Grid.Row="0" Grid.Column="2"
                                         Text="{Binding Settings.LastGeneratedManifestPath}"
                                         IsReadOnly="True" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Generated" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding Settings.LastManifestGeneratedAt}"
                                         IsReadOnly="True"
                                         Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Items" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="2"
                                         Text="{Binding Settings.LastManifestItemCount}"
                                         IsReadOnly="True"
                                         HorizontalAlignment="Left"
                                         Width="140"
                                         Margin="0,10,0,0" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Downloads &amp; Cache">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Local cache folder" FontWeight="SemiBold" />
                        <Grid Margin="0,5,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding Settings.LocalCacheFolder, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Width="90"
                                    Click="BrowseLocalCacheFolder_Click" />
                        </Grid>

                        <CheckBox Content="Allow Install to download or copy games into the local cache"
                                  IsChecked="{Binding Settings.AllowDownloads}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Mark games uninstalled when cached files are missing"
                                  IsChecked="{Binding Settings.TreatMissingFilesAsUninstalled}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Verify transferred files before marking a game installed"
                                  IsChecked="{Binding Settings.VerifyAfterTransfer}"
                                  Margin="0,0,0,8" />
                        <CheckBox Content="Remove incomplete temporary files after failed or cancelled transfers"
                                  IsChecked="{Binding Settings.RemoveIncompleteTransferFiles}"
                                  Margin="0,0,0,14" />

                        <TextBlock Text="Maximum concurrent transfers (1–4)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.TransferConcurrency, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Width="120"
                                 Margin="0,5,0,14" />

                        <TextBlock Text="Uninstall behavior" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding UninstallBehaviorOptions}"
                                  SelectedItem="{Binding Settings.UninstallBehavior, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Left"
                                  MinWidth="280"
                                  Margin="0,5,0,14" />

                        <WrapPanel>
                            <Button Content="Open cache folder"
                                    Click="OpenCacheFolder_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="Choose which meaningful events create Playnite notifications. Transfer progress stays inside the dashboard to avoid notification spam."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />
                        <CheckBox Content="Library update results"
                                  IsChecked="{Binding Settings.NotifyLibraryUpdateResults}"
                                  Margin="0,0,0,9" />
                        <CheckBox Content="Transfer completed"
                                  IsChecked="{Binding Settings.NotifyTransferCompleted}"
                                  Margin="0,0,0,9" />
                        <CheckBox Content="Transfer failed"
                                  IsChecked="{Binding Settings.NotifyTransferFailed}"
                                  Margin="0,0,0,9" />
                        <CheckBox Content="Source unavailable"
                                  IsChecked="{Binding Settings.NotifySourceUnavailable}"
                                  Margin="0,0,0,9" />
                        <CheckBox Content="Verification warnings"
                                  IsChecked="{Binding Settings.NotifyVerificationWarnings}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <CheckBox Content="Enable detailed import diagnostics"
                                  IsChecked="{Binding Settings.EnableDiagnostics}"
                                  Margin="0,0,0,14" />

                        <WrapPanel>
                            <Button Content="Verify setup and generate report"
                                    Click="VerifySetup_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Open latest verification report"
                                    Click="OpenLatestVerificationReport_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Open diagnostics folder"
                                    Click="OpenDiagnosticsFolder_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Open reports folder"
                                    Click="OpenReportsFolder_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="Open plugin data folder"
                                    Click="OpenPluginDataFolder_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                            <Button Content="How to update library"
                                    Click="ShowUpdateLibraryInstructions_Click"
                                    Margin="0,0,8,8"
                                    Padding="10,5" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="rclone timeout in seconds (5–300)" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Settings.RcloneTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left"
                                 Width="120"
                                 Margin="0,5,0,16" />

                        <GroupBox Header="Dangerous file removal option" Margin="0,0,0,14">
                            <StackPanel Margin="12">
                                <CheckBox Content="Allow uninstall outside the managed cache folder"
                                          IsChecked="{Binding Settings.AllowUninstallOutsideCacheFolder}"
                                          Margin="0,0,0,7" />
                                <TextBlock Text="Keep this disabled unless you fully understand the configured paths. Normal uninstall only removes plugin-managed cached copies and never removes cloud, NAS, or source-library files."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Legal-use boundary">
                            <TextBlock Margin="12"
                                       Text="This plugin does not provide games, ROMs, BIOS files, cracks, keys, artwork, storefront access, or download sources. It only imports and manages entries from manifests and storage locations supplied by the user."
                                       TextWrapping="Wrap" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
