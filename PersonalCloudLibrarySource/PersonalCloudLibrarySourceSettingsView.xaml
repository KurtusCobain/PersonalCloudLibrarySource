<UserControl x:Class="PersonalCloudLibrarySource.PersonalCloudLibrarySourceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">

            <TextBlock Text="Personal Cloud Library Source"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Import a personal library into Playnite from a local JSON file, local folder, external drive, NAS path, or rclone remote."
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Border BorderBrush="#3B4652"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="#1F252C"
                    Padding="14"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Setup Status"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#F3F6FA"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding SetupStatusHeadline}"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SetupStatusDetails}"
                               TextWrapping="Wrap"
                               Foreground="#D7E0EA"
                               Opacity="0.95"/>
                </StackPanel>
            </Border>

            <CheckBox Content="Enable this library source"
                      IsChecked="{Binding Settings.Enabled}"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Library display name:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.LibraryDisplayName, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="540"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Source Mode"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Source provider type:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding ProviderTypeOptions}"
                      SelectedItem="{Binding Settings.SourceProviderType, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="280"
                      Margin="0,0,0,6"/>
            <TextBlock Text="Use LocalFile for one manifest on disk, LocalFolder for a personal library root on disk or NAS, and RcloneRemote for rclone-backed cloud storage."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Local or NAS Setup"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Local manifest JSON path:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,6">
                <Button Content="Browse"
                        Click="BrowseLocalManifestPath_Click"
                        Width="90"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"/>
                <TextBox Text="{Binding Settings.LocalManifestPath, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="540"/>
            </DockPanel>
            <TextBlock Text="Use this for LocalFile mode, or to point LocalFolder mode at a generated manifest stored in plugin user data."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Local library root:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,6">
                <Button Content="Browse"
                        Click="BrowseLocalLibraryRoot_Click"
                        Width="90"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"/>
                <TextBox Text="{Binding Settings.LocalLibraryRoot, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="540"/>
            </DockPanel>
            <TextBlock Text="Examples: D:\PersonalLibrary, E:\PersonalLibrary, Z:\PersonalLibrary, \\NAS\PersonalLibrary"
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Manifest relative path:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.ManifestRelativePath, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="540"
                     Margin="0,0,0,6"/>
            <TextBlock Text="Optional for LocalFolder mode when the manifest lives inside the library root. Leave this blank when Local manifest JSON path points to a generated manifest in plugin user data."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Rclone Setup"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Rclone executable path:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,6">
                <Button Content="Browse"
                        Click="BrowseRcloneExecutablePath_Click"
                        Width="90"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"/>
                <TextBox Text="{Binding Settings.RcloneExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="540"/>
            </DockPanel>

            <TextBlock Text="Rclone remote name:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.RcloneRemoteName, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="540"
                     Margin="0,0,0,6"/>

            <TextBlock Text="Rclone manifest path:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.RcloneManifestPath, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="540"
                     Margin="0,0,0,6"/>

            <TextBlock Text="Rclone content root:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.RcloneContentRoot, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="540"
                     Margin="0,0,0,6"/>

            <TextBlock Text="Rclone timeout seconds:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.RcloneTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                     MinWidth="140"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Manifest Generation"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Generate a v3 manifest from a local folder, external drive, mapped drive, or NAS root without leaving Playnite."
                       TextWrapping="Wrap"
                       Opacity="0.7"
                       Margin="0,0,0,8"/>

            <WrapPanel Margin="0,0,0,6">
                <Button Content="Generate manifest from folder"
                        Click="GenerateManifestFromFolder_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open generated manifest"
                        Click="OpenGeneratedManifest_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open generated report"
                        Click="OpenGeneratedReport_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
            </WrapPanel>

            <TextBlock Text="Generated manifest path:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.LastGeneratedManifestPath, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     MinWidth="540"
                     Margin="0,0,0,6"/>

            <TextBlock Text="Last manifest generation time:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.LastManifestGeneratedAt, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     MinWidth="300"
                     Margin="0,0,0,6"/>

            <TextBlock Text="Last generated item count:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBox Text="{Binding Settings.LastManifestItemCount, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="True"
                     MinWidth="140"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Cache and Import Behavior"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Local cache folder:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,6">
                <Button Content="Browse"
                        Click="BrowseLocalCacheFolder_Click"
                        Width="90"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"/>
                <TextBox Text="{Binding Settings.LocalCacheFolder, UpdateSourceTrigger=PropertyChanged}"
                         MinWidth="540"/>
            </DockPanel>

            <CheckBox Content="Allow downloads to local cache"
                      IsChecked="{Binding Settings.AllowDownloads}"
                      Margin="0,0,0,4"/>
            <CheckBox Content="Treat missing files as uninstalled"
                      IsChecked="{Binding Settings.TreatMissingFilesAsUninstalled}"
                      Margin="0,0,0,4"/>

            <TextBlock Text="Uninstall behavior:"
                       FontWeight="SemiBold"
                       Margin="0,8,0,4"/>
            <ComboBox ItemsSource="{Binding UninstallBehaviorOptions}"
                      SelectedItem="{Binding Settings.UninstallBehavior, UpdateSourceTrigger=PropertyChanged}"
                      MinWidth="280"
                      Margin="0,0,0,6"/>

            <CheckBox Content="Allow uninstall outside cache folder"
                      IsChecked="{Binding Settings.AllowUninstallOutsideCacheFolder}"
                      Margin="0,0,0,16"/>

            <TextBlock Text="Checks and Tools"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,16">
                <Button Content="Verify setup / generate report"
                        Click="VerifySetup_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open latest verification report"
                        Click="OpenLatestVerificationReport_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Test rclone connection"
                        Click="TestRcloneConnection_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Test manifest load"
                        Click="TestManifestLoad_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Create sample manifest"
                        Click="CreateSampleManifest_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open cache folder"
                        Click="OpenCacheFolder_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open diagnostics folder"
                        Click="OpenDiagnosticsFolder_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open reports folder"
                        Click="OpenReportsFolder_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="Open plugin data folder"
                        Click="OpenPluginDataFolder_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
                <Button Content="How to update library"
                        Click="ShowUpdateLibraryInstructions_Click"
                        Margin="0,0,8,8"
                        Padding="10,4"/>
            </WrapPanel>

            <Expander Header="Diagnostics and Advanced Options"
                      IsExpanded="False">
                <StackPanel Margin="0,8,0,0">
                    <CheckBox Content="Enable import diagnostics"
                              IsChecked="{Binding Settings.EnableDiagnostics}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="Auto-refresh on Playnite startup"
                              IsChecked="{Binding Settings.AutoRefreshOnApplicationStart}"
                              Margin="0,0,0,6"/>
                    <CheckBox Content="Auto-generate manifest on Playnite startup"
                              IsChecked="{Binding Settings.AutoGenerateManifestOnApplicationStart}"
                              Margin="0,0,0,6"/>
                    <TextBlock Text="These startup options are lightweight placeholders for the v0.2 setup flow. They do not auto-download your full library."
                               TextWrapping="Wrap"
                               Opacity="0.7"
                               Margin="0,0,0,8"/>
                </StackPanel>
            </Expander>

            <Border BorderBrush="#666666"
                    BorderThickness="1"
                    Padding="10"
                    CornerRadius="4"
                    Margin="0,16,0,0">
                <TextBlock Text="Legal-use note: this plugin does not provide games, ROMs, BIOS files, cracks, keys, artwork, storefront access, or download sources. It only imports entries from manifests supplied by the user."
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
