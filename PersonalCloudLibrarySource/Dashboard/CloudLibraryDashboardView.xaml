<UserControl x:Class="PersonalCloudLibrarySource.CloudLibraryDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="760">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource LOCPLSDashboardTitle}"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,6,0,0" />
            </StackPanel>

            <GroupBox Grid.Row="1"
                      Header="{DynamicResource LOCPLSSourceHeading}"
                      Margin="0,0,0,12">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LOCPLSSourceType}" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SourceTypeDisplayName}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LOCPLSSourceLocation}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SourceDescription}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LOCPLSManifestLocation}" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ManifestDescription}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Header="{DynamicResource LOCPLSLibraryStatusHeading}"
                      Margin="0,0,0,12">
                <UniformGrid Columns="4" Margin="12">
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource LOCPLSManifestItems}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ManifestItemCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource LOCPLSImportedGames}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ImportedGameCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource LOCPLSCachedGames}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CachedGameCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource LOCPLSWarnings}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WarningCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Row="3"
                      Header="{DynamicResource LOCPLSTransfersHeading}"
                      Margin="0,0,0,12">
                <UniformGrid Columns="2" Margin="12">
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource LOCPLSActiveTransfers}" />
                        <TextBlock Text="{Binding ActiveTransferCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="4">
                        <TextBlock Text="{DynamicResource LOCPLSFailedTransfers}" />
                        <TextBlock Text="{Binding FailedTransferCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Row="4"
                      Header="{DynamicResource LOCPLSCacheHeading}"
                      Margin="0,0,0,12">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource LOCPLSCacheLocation}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding CachePath}" TextWrapping="Wrap" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="5" Header="{DynamicResource LOCPLSQuickActions}">
                <WrapPanel Margin="12">
                    <Button Content="{DynamicResource LOCPLSRunSetupWizard}"
                            Command="{Binding RunSetupWizardCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSUpdateLibraryHelp}"
                            Command="{Binding ShowUpdateLibraryInstructionsCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSVerifyLibrary}"
                            Command="{Binding VerifyLibraryCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSGenerateManifest}"
                            Command="{Binding GenerateManifestCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSOpenSourceLocation}"
                            Command="{Binding OpenSourceLocationCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSOpenCacheFolder}"
                            Command="{Binding OpenCacheFolderCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSOpenLatestReport}"
                            Command="{Binding OpenLatestReportCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                    <Button Content="{DynamicResource LOCPLSOpenSettings}"
                            Command="{Binding OpenSettingsCommand}"
                            Margin="0,0,8,8"
                            Padding="10,5" />
                </WrapPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</UserControl>
